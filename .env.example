# Semicolon-delimited on Windows; colon-delimited on macOS/Linux.
# Alternatively set allowed_roots in ~/.antigravity-bridge/config.json
# (recommended for marketplace installs) — env wins when both are set.
# Examples:
#   Windows:     AGY_ALLOWED_ROOTS=C:\Projects\project-one;C:\Projects\project-two
#   macOS/Linux: AGY_ALLOWED_ROOTS=/home/user/project-one:/home/user/project-two
AGY_ALLOWED_ROOTS=/path/to/project

# Executable name or explicit path. Leave as "agy" for auto-discovery from PATH/well-known locations.
AGY_BIN=agy
# Stop a turn after this many seconds without a meaningful init/step progress event.
AGY_DEFAULT_INACTIVITY_TIMEOUT_SECONDS=300
# Absolute wall-clock safety cap, even while progress continues.
# Near this deadline the bridge asks the worker to wrap up (FINISH_NOW) so
# partial work is handed off as a normal result instead of a hard kill.
AGY_MAX_TURN_SECONDS=1800
# Optional observed execution budgets; calibrate against useful-result benchmarks.
# AGY_MAX_STEPS=48
# AGY_MAX_TURN_TOKENS=60000
# Legacy alias for AGY_DEFAULT_INACTIVITY_TIMEOUT_SECONDS (used only when the new variable is unset).
# AGY_DEFAULT_TIMEOUT_SECONDS=300
AGY_MAX_STDERR_BYTES=32768
AGY_SANDBOX=false
AGY_DANGEROUSLY_SKIP_PERMISSIONS=false

# Optional fixed worker choices.
# AGY_MODEL=
# AGY_EFFORT=high
# AGY_AGENT=

# Per-user config file path (default ~/.antigravity-bridge/config.json).
# AGY_USER_CONFIG=

# Optional directory for persistent NDJSON event run logs. By default all bridge
# instances for the current user share the OS-specific state directory documented
# in docs/advanced.md.
# AGY_RUNS_DIR=

# Local read-only dashboard configuration (127.0.0.1 loopback only with per-process token)
AGY_DASHBOARD_ENABLED=true
# Port for the dashboard HTTP server (0 for ephemeral/dynamic port, or fixed port between 1 and 65535)
AGY_DASHBOARD_PORT=0

# Optional arguments inserted before the bridge's agy flags. Useful when
# AGY_BIN points to a wrapper such as Node; normally leave unset.
# AGY_BASE_ARGS_JSON=[]
