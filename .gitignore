node_modules/
# dist/ trees are shipped in the Git marketplace snapshot so `codex plugin
# marketplace upgrade` delivers prebuilt artifacts; installs never build.
!dist/
dist/*.tsbuildinfo
plugins/antigravity-mcp-bridge/dist/*.tsbuildinfo
coverage/
*.log
.env
.env.*
!.env.example
.antigravity-bridge/
work/
*.tgz

# The distributable plugin bundles its production dependencies so installs
# never run npm; un-ignore that tree (the global node_modules/ rule above
# still covers the repository root).
!plugins/antigravity-mcp-bridge/node_modules/
!plugins/antigravity-mcp-bridge/node_modules/**
